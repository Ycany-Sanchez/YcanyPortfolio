# Copy to .env.local for local development. Never commit real credentials.
# Resend API key and a sender on a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional: the inbox receiving project inquiries (this is the default).
CONTACT_TO_EMAIL=ycanyashra.sanchez2006@gmail.com

# Set to the canonical HTTPS origin when deploying. No trailing path needed.
SITE_URL=http://localhost:3000
